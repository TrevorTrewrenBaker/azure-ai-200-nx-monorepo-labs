{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/vue": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "~4.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.0.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-vue": "^9.16.1",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "postcss": "^8.5.16",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0",
    "vue-tsc": "^2.2.8"
  },
  "workspaces": [
    "apps/*",
    "apps/*-e2e",
    "libs/shared/ui-design-system",
    "libs/shared",
    "libs/shared/*"
  ],
  "allowScripts": {
    "**": true,
    "@swc/core@1.15.8": true,
    "nx@23.1.1": true
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "scripts": {
    "clean:dist": "powershell -Command \"Get-ChildItem -Path libs,apps -Recurse -Filter dist -Directory | Remove-Item -Recurse -Force\"",
    "clean:modules": "powershell -Command \"Remove-Item -Recurse -Force node_modules -ErrorAction SilentlyContinue\"",
    "clean:lockfile": "powershell -Command \"Remove-Item -Force package-lock.json -ErrorAction SilentlyContinue\"",
    "scripts:approve": "npm approve-scripts --allow-scripts-pending --loglevel verbose",
    "install:normal": "npm install --loglevel verbose",
    "install:legacy": "npm install --legacy-peer-deps --loglevel verbose",
    "reset": "nx reset --verbose",
    "build:all": "nx run-many --target=build --all --verbose",
    "graph": "nx graph --verbose",
    "affected:build": "nx affected --target=build --verbose",
    "affected:test": "nx affected --target=test",
    "lint:all": "nx run-many --target=lint --all",
    "test:all": "nx run-many --target=test --all",
    "list:projects": "nx show projects --verbose",
    "check:outdated": "npm outdated --loglevel verbose",
    "check:deps:unused": "npx depcheck --verbose",
    "serve:aks": "nx serve aks-deploy-monitor-lab --verbose"
  }
}
